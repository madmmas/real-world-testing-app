DATABASE_URL=postgresql://rwa:rwa@localhost:5433/rwa
SESSION_SECRET=change-me-session-secret
JWT_SECRET=change-me-jwt-secret
JWT_ISSUER=rwa-auth
JWT_AUDIENCE=rwa
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES_DAYS=7
JWT_REFRESH_ABSOLUTE_DAYS=30
WEB_ORIGIN=http://localhost:3000
ADMIN_ORIGIN=http://localhost:3004
AUTH_PORT=3003
USER_SERVICE_PORT=3005
BOOKS_SERVICE_PORT=3006
SALES_SERVICE_PORT=3007
PAYMENT_SERVICE_PORT=3008
API_KEY_SERVICE_PORT=3009
CART_SERVICE_PORT=3010
ADMIN_PORT=3004
USER_SERVICE_URL=http://localhost:3005
BOOKS_SERVICE_URL=http://localhost:3006
SALES_SERVICE_URL=http://localhost:3007
PAYMENT_SERVICE_URL=http://localhost:3008
API_KEY_SERVICE_URL=http://localhost:3009
CART_SERVICE_URL=http://localhost:3010
CART_TTL_HOURS=72
INTERNAL_SERVICE_SECRET=change-me-internal
ALTCHA_HMAC_SECRET=change-me-altcha-hmac

# Optional Stripe Connect (demo checkout if unset)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# PLATFORM_FEE_BPS=1000

# Optional Google OAuth (501 if unset)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=http://localhost:3000/auth/oauth/google/callback

# Unleash (feature flags). UI: http://localhost:4242  admin / unleash4all
# See docs/unleash.md. Tokens below match docker-compose INIT_* values (first boot only).
UNLEASH_URL=http://localhost:4242/api/
UNLEASH_API_TOKEN=default:development.unleash-insecure-api-token
VITE_UNLEASH_URL=http://localhost:4242/api/frontend
VITE_UNLEASH_CLIENT_KEY=default:development.unleash-insecure-frontend-api-token

# OpenPanel. Dashboard: http://localhost:3350  (make up services=openpanel)
# Gated by Unleash flag `analytics.openpanel`. Env overrides that flag:
#   true / 1 / yes / on  → always send
#   false / 0 / no / off → never send
#   unset                → Unleash only
# VITE_OPENPANEL_ENABLED=true
VITE_OPENPANEL_API_URL=http://localhost:3350/api
# Client id from OpenPanel → project → clients (required before events ship)
# VITE_OPENPANEL_CLIENT_ID=

# Elasticsearch (book search + Docker logs). Kibana: http://localhost:5601
# make up services=elasticsearch  → Filebeat ships container logs
# Search uses ES only when Unleash `search.elasticsearch` is on, or:
#   ELASTICSEARCH_SEARCH_ENABLED=true
ELASTICSEARCH_URL=http://localhost:9200
# ELASTICSEARCH_SEARCH_ENABLED=true

# Kong API gateway (rate limits + one public port). Off until:
#   make up services=gateway
# Then uncomment so Vite proxies through Kong (restart pnpm dev:frontend).
# Kong validates access JWTs using the JWT_* values above (same as the backends).
# API_GATEWAY_URL=http://localhost:8080
# Docker nginx (started by `make up`) talks to backends directly unless:
# NGINX_GATEWAY=http://kong:8000

# OpenTelemetry (Jaeger + Prometheus + Grafana). make up services=observability
# Gated by Unleash `observability.opentelemetry`. Restart backends after toggling.
#   OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Internal HTTP: abort after 8s, retry twice on 5xx / timeout / 429
# SERVICE_FETCH_TIMEOUT_MS=8000
# SERVICE_FETCH_RETRIES=2

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM="Books Library <noreply@localhost>"

# MinIO (S3). Console http://localhost:9001  (rwa / rwaminio1)
# Browser GET via nginx: https://localhost:3000/media/<key>
# Browser GET via Vite: http://localhost:3000/media/<key>
# Host SDK / mc: http://localhost:9000  (TLS is nginx only)
MINIO_ROOT_USER=rwa
MINIO_ROOT_PASSWORD=rwaminio1
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=rwa
S3_SECRET_KEY=rwaminio1
S3_BUCKET=rwa
S3_FORCE_PATH_STYLE=true

# Docker Compose: uncomment so `docker compose up -d` starts every backend.
# Or list only the services you want: auth-service,user-service,books-service,sales-service,payment-service,api-key-service,unleash
# OpenPanel is profile `openpanel`: docker compose --profile openpanel up -d
# Elasticsearch is profile `elasticsearch`: docker compose --profile elasticsearch up -d
# Kong is profile `gateway`: docker compose --profile gateway up -d
# Observability is profile `observability`: docker compose --profile observability up -d
# Frontends (nginx HTTPS) is profile `frontend`: docker compose --profile frontend up -d
# MinIO is profile `minio`: docker compose --profile minio up -d
# Mailpit is profile `mail`: docker compose --profile mail up -d
# COMPOSE_PROFILES=backend
